{
  "name": "dsh-codex-kit",
  "version": "0.3.0",
  "description": "Measured context budgets, progressive skill retrieval, local metrics, and stable capability profiles for DeepSeek Harness.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./capability-profiles": "./src/capability-profiles.js",
    "./efficiency-ledger": "./src/efficiency-ledger.js",
    "./output-budget": "./src/output-budget.js",
    "./retrieval": "./src/retrieval.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "bin": {
    "dsh-kit": "./bin/dsh-kit.mjs"
  },
  "files": [
    "bin",
    "config",
    "docs",
    "mobile",
    "remote",
    "scripts",
    "src",
    "install-full.ps1",
    "install-full.sh",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:public": "node scripts/verify-public-repo.mjs",
    "check": "npm run check:syntax && npm test && npm run check:public",
    "benchmark:retrieval": "node scripts/benchmark-retrieval.mjs",
    "doctor": "node bin/dsh-kit.mjs doctor",
    "pack:dry": "npm pack --dry-run",
    "remote:bridge": "node remote/bridge.mjs",
    "remote:relay": "node remote/relay-server.mjs",
    "remote:agent": "node remote/agent.mjs",
    "remote:bluetooth-install": "node scripts/install-bluetooth.mjs",
    "mobile:ensure-android-sdk": "node scripts/ensure-android-compile-sdk.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-output-retention": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dltsum/dsh-codex-kit.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-observability",
    "context-budget",
    "output-spill",
    "skill-retrieval",
    "token-optimization"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
